// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = "postgres://default:wHN3YdP4MIjD@ep-icy-feather-a49v61kj-pooler.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require&pgbouncer=true&connect_timeout=15" // uses connection pooling
  directUrl = "postgres://default:wHN3YdP4MIjD@ep-icy-feather-a49v61kj.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require" // uses a direct connection
}

model Product {
  id        String     @default(cuid()) @id
  name     String
  description String
  size String[] 
  color String[] 
  imageUrl String[] @map(name: "image_url")
  price Decimal @default(0.0) @db.Decimal(10, 2) 
  weight Decimal @default(0.0) @db.Decimal(10, 2) 
  stock Int @default(0)
  @@map(name: "products")
}

model User {
  id            String       @default(cuid()) @id
  name          String?
  email         String?   @unique
  createdAt     DateTime  @default(now()) @map(name: "created_at")
  updatedAt     DateTime  @updatedAt @map(name: "updated_at")
  @@map(name: "users")
}